# Optional overrides. Copy to .env.local; the historical .env is not loaded.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://127.0.0.1:19006
# On a physical device, add this computer's LAN IP to DJANGO_ALLOWED_HOSTS.
# DJANGO_DATABASE_PATH=/absolute/path/to/a/copy/of/db.sqlite3
# Email is printed in the terminal by default; no SMTP account is required.
